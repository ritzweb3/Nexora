# Copy this file to .env and fill in real values before running in production.
# Local dev doesn't require any of this — bootstrapEnv.js auto-fills
# JWT_SECRET and ADMIN_PASSWORD the first time you run the app.

PORT=4000

# Used to sign login sessions (JWTs). Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Seeds the one admin account on first boot. Change these before you ever
# deploy this anywhere reachable by anyone but you. After first boot, change
# the admin password by editing nexora-data.json's "admins" entry directly
# (there is no "forgot password" flow for admin, on purpose).
ADMIN_EMAIL=admin@nexora.local
ADMIN_PASSWORD=change_me_before_deploying

# The wallet address projects send campaign payment to. Shown on the
# campaign creation page. Set this to your real company wallet before
# launching -- the placeholder below is not a real address.
COMPANY_WALLET_ADDRESS=0xYourCompanyWalletAddressGoesHere

# Suggested-payout formula (admin can always override the number before
# saving) -- dollars paid per 1,000 verified views / per 500 verified likes.
RATE_PER_1000_VIEWS=2
RATE_PER_500_LIKES=1

# --- Google sign-in: real, but needs your own OAuth client to complete ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
